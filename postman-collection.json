{
  "info": {
    "name": "Node.js TDD Web API Starter",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET /users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users"
      }
    },
    {
      "name": "POST /users",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/users",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"profile@example.test\",\n  \"firstName\": \"Example\",\n  \"lastName\": \"Profile\"\n}"
        }
      }
    },
    {
      "name": "GET /users/{id}",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users/{{userId}}"
      }
    },
    {
      "name": "PUT /users/{id}",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/users/{{userId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Updated\"\n}"
        }
      }
    },
    {
      "name": "DELETE /users/{id}",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/users/{{userId}}"
      }
    },
    {
      "name": "GET /health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "GET /health/live",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/live"
      }
    },
    {
      "name": "GET /health/ready",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health/ready"
      }
    }
  ]
}
