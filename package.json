{
  "name": "nodejs-tdd-web-api-starter",
  "version": "1.0.0",
  "description": "A clean, TDD-first Node.js + TypeScript starter for REST APIs",
  "homepage": "https://github.com/asrulazwan0/nodejs-tdd-base-web-api#readme",
  "bugs": {
    "url": "https://github.com/asrulazwan0/nodejs-tdd-base-web-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asrulazwan0/nodejs-tdd-base-web-api.git"
  },
  "license": "ISC",
  "author": "Asrul Azwan",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/app.ts",
    "start": "node dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.22.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "uuid": "^8.3.2",
    "zod": "^3.24.1"
  }
}
